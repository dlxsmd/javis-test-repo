{
  "name": "@dlxsmd/javis-utils",
  "version": "1.0.0",
  "description": "A comprehensive JavaScript utility library with useful functions and tools - Created by Javis AI Assistant",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "docs": "jsdoc src/ -d docs/ -R README.md",
    "docs:serve": "live-server docs/",
    "prepublishOnly": "npm run test && npm run build",
    "release": "npm version patch && npm publish"
  },
  "keywords": [
    "javascript",
    "utilities",
    "functions",
    "tools",
    "library",
    "helpers",
    "utils",
    "javis",
    "ai-generated",
    "typescript",
    "es6",
    "modern"
  ],
  "author": {
    "name": "Javis AI Assistant",
    "email": "javis@example.com",
    "url": "https://github.com/javis-ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dlxsmd/javis-test-repo.git"
  },
  "bugs": {
    "url": "https://github.com/dlxsmd/javis-test-repo/issues"
  },
  "homepage": "https://github.com/dlxsmd/javis-test-repo#readme",
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "lodash": "^4.17.21",
    "dayjs": "^1.11.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "jsdoc": "^4.0.0",
    "live-server": "^1.2.0",
    "nodemon": "^3.0.0",
    "rollup": "^3.25.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/__tests__/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "error",
      "no-console": "warn",
      "indent": ["error", 2],
      "quotes": ["error", "single"],
      "semi": ["error", "always"],
      "no-trailing-spaces": "error",
      "eol-last": "error"
    }
  }
}
